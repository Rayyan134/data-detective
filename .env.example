# Copy this file to .env and fill in real values:
#
#   PowerShell:  Copy-Item .env.example .env
#
# .env is git-ignored. Never commit real keys, and never paste them into code.

# The LLM provider is still being decided. Nothing reads these values yet.
# Uncomment and fill them in once the agent layer is built.

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=replace-me

# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-me
