# Copy this file to .env and fill in real values:
#
#   PowerShell:  Copy-Item .env.example .env
#
# .env is git-ignored. Never commit real keys, and never paste them into code.

# ---------------------------------------------------------------------------
# Gemini (used by src/llm_client.py)
# ---------------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=replace-me

# Optional. Defaults to gemini-3.6-flash (free tier, stable).
# gemini-3.8-flash is newer but was returning HTTP 503 (overloaded) on the
# free tier during setup. Other options: gemini-3.5-flash-lite, gemini-flash-latest
# GEMINI_MODEL=gemini-3.6-flash

# Optional. Seconds to wait per request. Defaults to 60.
# Flash is a reasoning model, so raise this if you see timeouts on a slow link.
# GEMINI_TIMEOUT=60
